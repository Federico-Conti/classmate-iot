      ]
    ]
  },
  {
    "id": "telemetry-assignment-db",
    "type": "classmate-db",
    "z": "telemetry-ingestion-tab",
    "name": "Find active assignment",
    "database": "/data/sqlite/classmate.db",
    "x": 940,
    "y": 100,
    "wires": [
      [
        "telemetry-assignment-gate"
      ]
    ]
  },
  {
    "id": "telemetry-assignment-gate",
    "type": "function",
    "z": "telemetry-ingestion-tab",
    "name": "Allow assigned device",
    "func": "const assignment = msg.payload;\nif (!assignment || assignment.deviceId !== msg.telemetry.deviceId || !assignment.childId) {\n    return [null, { topic: msg.topic, payload: { reason: 'unassigned-device' } }];\n}\nmsg.childId = assignment.childId;\nmsg.payload = msg.telemetry;\ndelete msg.telemetry;\ndelete msg.params;\ndelete msg.dbOperation;\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1180,
    "y": 100,
    "wires": [
      [
        "telemetry-sequence-prepare"
      ],
      [
        "telemetry-rejected-debug"
      ]
    ]
  },
  {
    "id": "telemetry-sequence-prepare",
    "type": "function",
    "z": "telemetry-ingestion-tab",
    "name": "Prepare sequence check",
    "func": "msg.telemetry = msg.payload;\nmsg.dbOperation = 'updateDeviceState';\nmsg.params = { deviceId: msg.telemetry.deviceId, lastReceivedAt: msg.receivedAt, lastBootId: msg.telemetry.bootId, lastSequence: msg.telemetry.sequence };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1435,
    "y": 100,
    "wires": [
      [
        "telemetry-sequence-db"
      ]
    ]
  },
  {
    "id": "telemetry-sequence-db",
    "type": "classmate-db",
    "z": "telemetry-ingestion-tab",
    "name": "Accept new sequence",
    "database": "/data/sqlite/classmate.db",
    "x": 1650,
    "y": 100,
    "wires": [
      [
        "telemetry-sequence-gate"
      ]
    ]
  },
  {
    "id": "telemetry-sequence-gate",
    "type": "function",
    "z": "telemetry-ingestion-tab",
    "name": "Forward new sample",
    "func": "if (!msg.payload.accepted) {\n    return [null, { topic: msg.topic, payload: { reason: msg.payload.reason } }];\n}\nmsg.payload = msg.telemetry;\ndelete msg.telemetry;\ndelete msg.params;\ndelete msg.dbOperation;\nreturn [msg, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1865,
    "y": 100,
    "wires": [
      [
        "telemetry-device-context"
      ],
      [
        "telemetry-rejected-debug"
      ]
    ]
  },
  {
    "id": "telemetry-device-context",
    "type": "function",
    "z": "telemetry-ingestion-tab",
    "name": "Maintain per-device context",
    "func": "const deviceId = msg.payload.deviceId;\nconst contexts = flow.get('processingByDevice') || {};\nconst previous = contexts[deviceId];\nconst sameSession = previous && previous.childId === msg.childId && previous.bootId === msg.payload.bootId;\ncontexts[deviceId] = {\n    childId: msg.childId,\n    bootId: msg.payload.bootId,\n    lastSequence: msg.payload.sequence,\n    lastReceivedAt: msg.receivedAt,\n    rssiWindow: sameSession ? previous.rssiWindow : [],\n};\nflow.set('processingByDevice', contexts);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 2100,
    "y": 100,
    "wires": [
      [
        "telemetry-debug"
      ]
    ]
  },

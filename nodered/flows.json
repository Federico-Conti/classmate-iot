    ]
  },
  {
    "id": "telemetry-assignment-prepare",
    "type": "function",
    "z": "telemetry-ingestion-tab",
    "name": "Prepare device lookup",
    "func": "msg.telemetry = msg.payload;\nmsg.dbOperation = 'getActiveAssignmentByDevice';\nmsg.params = { deviceId: msg.telemetry.deviceId };\nreturn msg;",
    "outputs": 1,

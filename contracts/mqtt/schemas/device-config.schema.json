{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classmate.local/schemas/mqtt/v1/device-config.schema.json",
  "title": "ClassMate wearable runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deviceId", "revision", "telemetryIntervalMs", "targetNetwork"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deviceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "telemetryIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
    "targetNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ssid", "bssid"],
      "properties": {
        "ssid": { "type": "string", "minLength": 1, "maxLength": 32 },
        "bssid": { "type": "string", "pattern": "^[0-9A-F]{2}(:[0-9A-F]{2}){5}$" }
      }
    }
  }
}

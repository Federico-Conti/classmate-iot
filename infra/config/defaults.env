COMPOSE_PROJECT_NAME=classmate-iot
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.22
NODE_RED_IMAGE=nodered/node-red:4.0.9-22
POC_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883
NODE_RED_PORT=1880
TZ=Europe/Rome
MQTT_WEARABLE_USERNAME=esp32-001
MQTT_NODERED_USERNAME=node-red
MQTT_PARENT_USERNAME=parent-poc
MQTT_WEARABLE_PASSWORD_FILE=./infra/secrets/mqtt_wearable_password
MQTT_NODERED_PASSWORD_FILE=./infra/secrets/mqtt_nodered_password
MQTT_PARENT_PASSWORD_FILE=./infra/secrets/mqtt_parent_password
MOSQUITTO_DATA_VOLUME=classmate-mosquitto-data
MOSQUITTO_LOGS_VOLUME=classmate-mosquitto-logs
SQLITE_DATA_VOLUME=classmate-sqlite
